# Скопируйте в .env для локального запуска без Docker: cp .env.example .env
# Значения ниже совпадают с docker-compose.yml и подходят только для разработки.

NODE_ENV=development
PORT=3000

# База из docker compose (порт проброшен на 127.0.0.1:5432)
DATABASE_URL=postgresql://cv:cv@localhost:5432/cv?schema=public
